# ==============================================================================
# SANCTUARY PASTOR - VERCEL & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# For Vercel:
# Add these variables under: Vercel Project Dashboard -> Settings -> Environment Variables
# Check both "Production", "Preview", and "Development".
# ==============================================================================

# 1. Google Gemini API Key
# Used for deep empathetic pastoral prayer generation and theological biblical references.
# Get an API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. Groq API Key (Recommended for ultra-fast generation & automatic failover)
# Used for high-speed prayer generation with silent automatic rollup.
# Get an API key at: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. Application URL (Optional, auto-provided on Vercel as VERCEL_URL)
APP_URL="http://localhost:3000"

# 3. Paddle Billing / Checkout
# Create a Paddle client-side token in Paddle > Developer tools > Authentication.
# Client-side tokens are safe to expose in the browser; never expose Paddle API keys here.
VITE_PADDLE_CLIENT_TOKEN=""
# sandbox for testing; production after Paddle approves and you are ready to go live
VITE_PADDLE_ENVIRONMENT="sandbox"
# Paddle price IDs created for Sanctuary Pastor
VITE_PADDLE_PRICE_WEEKLY="pri_"
VITE_PADDLE_PRICE_MONTHLY="pri_"
VITE_PADDLE_PRICE_YEARLY="pri_"

# Server-side Paddle webhook secret. Keep this secret and add it only to Vercel/server environment variables.
PADDLE_WEBHOOK_SECRET_KEY=""
# Server-side Paddle API key, only needed if you later add server-side transaction/subscription verification.
PADDLE_API_KEY=""
PADDLE_ENVIRONMENT="sandbox"
PADDLE_PRICE_WEEKLY="pri_"
PADDLE_PRICE_MONTHLY="pri_"
PADDLE_PRICE_YEARLY="pri_"

# ── Paddle MCP server (https://developer.paddle.com/sdks/ai/paddle-mcp/) ──
# Sandbox API key (prefixed pdl_sdbx_) used to authenticate opencode/VS Code/Cursor
# against the remote Paddle MCP server at https://sandbox-mcp.paddle.com/mcp
# Create a key at: Paddle Dashboard > Developer tools > Authentication
PADDLE_SANDBOX_API_KEY="pdl_sdbx_"
